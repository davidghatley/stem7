
# Stem 7 Bold: glyph source. Same format as regular.s7.
# Rule: vertical stems are 2 cells, horizontals stay 1 cell; widen rather than close a counter.
# Figures are tabular at 7 cells. The mark and the pantry glyphs are the same drawings as Regular.
# No dh ligature in Bold: the mark is a one-cell drawing and stays one. Type it in Regular, or use U+E000.

# space: 4 cells in Bold, one more than Regular, to match the wider letters.
glyph space U+0020,U+00A0 width=4

glyph figurespace U+2007 width=8

